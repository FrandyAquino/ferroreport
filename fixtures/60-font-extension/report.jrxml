<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="font-extension" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">
	<!-- "Fixture Condensed" and "Fixture Set" come from the font extension in jasper-extension/
	     (a family with its own font files, and a font set over it and DejaVu Serif). -->
	<style name="Base" isDefault="true" fontName="Fixture Condensed" fontSize="11"/>
	<field name="city" class="java.lang.String"/>
	<field name="greeting" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<title>
		<band height="150">
			<staticText>
				<reportElement x="0" y="0" width="515" height="26"/>
				<textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Greetings from the font extension's own fonts]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="250" height="100"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[This paragraph is set in a condensed face that only the font extension has: it is narrower than DejaVu Sans, so a text measured in the wrong font wraps elsewhere. Àçcéñtèd lëttèrs stay in it too.]]></text>
			</staticText>
			<staticText>
				<reportElement x="265" y="34" width="250" height="100"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right"><font fontName="Fixture Set" size="12"/></textElement>
				<text><![CDATA[A font set: Latin in the condensed face, Ελληνικά and Кириллица in DejaVu Serif, the second family of the set.]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="20">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="150" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[City]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="150" y="0" width="265" height="20" backcolor="#DDDDDD"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Greeting]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="415" y="0" width="100" height="20" backcolor="#DDDDDD"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Amount]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="150" height="18"/>
				<textFieldExpression><![CDATA[$F{city}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="150" y="0" width="265" height="18"/>
				<textElement><font fontName="Fixture Set"/></textElement>
				<textFieldExpression><![CDATA[$F{greeting}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="415" y="0" width="100" height="18"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="paragraphs" whenNoDataType="AllSectionsNoDetail" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30">
	<!-- Paragraph indents and tab stops (<paragraph>): first line, left and right indents from a
	     style, default stops every 40 points and custom left, center and right stops, with the
	     element aligned left, right and centered; plain and styled text, padding, line spacing,
	     words longer than the room left, tabs in a text without paragraph settings, justified
	     text and an HTML list with indents. -->
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<style name="Indented" style="Base">
		<box padding="0"><pen lineWidth="0.5"/></box>
		<paragraph firstLineIndent="15" leftIndent="30" rightIndent="10"/>
	</style>
	<title>
		<band height="560">
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" x="0" y="0" width="270" height="40"/>
				<textElement markup="styled"/>
				<textFieldExpression><![CDATA["<style backcolor=\"#CCEEFF\">Default stops every 40 points, left aligned. The first line of each paragraph starts at its indent:\n\tapples      \tpears   \tplums   \tfigs   \tlimes   \n\tbread\tbutter\tmarmalade\tcheese\tolives\tsalt\n\tred\tgreen\tblue\tturquoise\tblack</style>"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" x="285" y="0" width="270" height="40"/>
				<textElement textAlignment="Right" markup="styled"/>
				<textFieldExpression><![CDATA["<style backcolor=\"#CCEEFF\">Default stops every 40 points, right aligned. Each line is aligned by its last segment:\n\tapples      \tpears   \tplums   \tfigs   \tlimes   \n\tbread\tbutter\tmarmalade\tcheese\tolives\tsalt\n\tred\tgreen\tblue\tturquoise\tblack</style>"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" positionType="Float" x="0" y="140" width="270" height="40"/>
				<textElement markup="styled">
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.6">
						<tabStop position="45" alignment="Center"/>
						<tabStop position="120" alignment="Right"/>
					</paragraph>
				</textElement>
				<textFieldExpression><![CDATA["A center stop at 45 and a right stop at 120, then the default ones, with proportional spacing:\n\tone\ttwo\tthree\tfour\n\tcentered words\t1,234.50\tx\n\ta\tb\tc\td\te\tf"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" positionType="Float" x="285" y="140" width="270" height="40"/>
				<textElement textAlignment="Center" markup="styled">
					<paragraph lineSpacing="Fixed" lineSpacingSize="15">
						<tabStop position="45" alignment="Center"/>
						<tabStop position="120" alignment="Right"/>
					</paragraph>
				</textElement>
				<textFieldExpression><![CDATA["The same stops in a centered element with fixed spacing of 15 points:\n\tone\ttwo\tthree\tfour\n\tcentered words\t1,234.50\tx\n\ta\tb\tc\td\te\tf"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Indented" positionType="Float" x="0" y="290" width="270" height="60"/>
				<textElement>
					<paragraph firstLineIndent="25" leftIndent="10" rightIndent="40"/>
				</textElement>
				<text><![CDATA[Plain text with its own indents, overriding the style: twenty-five points more on the first line, ten on the left and forty on the right of every line, wrapped as usual.
A second paragraph starts at its first line indent again.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="285" y="290" width="270" height="60"/>
				<box padding="8"><pen lineWidth="0.5"/></box>
				<textElement/>
				<text><![CDATA[Tabs without paragraph settings, in a box with padding:
Item	Qty	Price	Total
Pens	12	1.20	14.40
Paper	3	4.75	14.25]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" positionType="Float" x="0" y="365" width="160" height="40"/>
				<textElement markup="styled">
					<paragraph tabStopWidth="25"/>
				</textElement>
				<textFieldExpression><![CDATA["A\n\tB\t\tB2\tB3 averyveryverylongwordthatdoesnotfit\n\t\tC\tC2\nD\tD2\tD3"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement style="Indented" positionType="Float" x="200" y="365" width="160" height="40"/>
				<textElement textAlignment="Right" markup="styled">
					<paragraph tabStopWidth="25"/>
				</textElement>
				<textFieldExpression><![CDATA["A\n\tB\t\tB2\tB3 averyveryverylongwordthatdoesnotfit\n\t\tC\tC2\nD\tD2\tD3"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="395" y="365" width="160" height="40"/>
				<box leftPadding="6" rightPadding="4"><pen lineWidth="0.5"/></box>
				<textElement markup="styled">
					<font size="10"/>
					<paragraph leftIndent="12">
						<tabStop position="30" alignment="Left"/>
						<tabStop position="90" alignment="Right"/>
					</paragraph>
				</textElement>
				<textFieldExpression><![CDATA["Name\tQty\tAmount\nPens\t12\t14.40\n<style isBold=\"true\">Total</style>\t\t<style isBold=\"true\">28.65</style>"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="420" width="270" height="100"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Justified">
					<paragraph firstLineIndent="20" leftIndent="10" rightIndent="5"/>
				</textElement>
				<text><![CDATA[Justified paragraphs with a first line indent spread their words over the room each line has, as printed contracts and letters usually look, ending each paragraph on its natural width.
A second paragraph, also justified: its last line stays as it is, and a comma, in the middle.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="285" y="420" width="270" height="100"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Justified" markup="html">
					<paragraph leftIndent="15"/>
				</textElement>
				<text><![CDATA[<ul><li>The first item of a list with a left indent, long enough to wrap over lines.</li><li>The second item.</li></ul>]]></text>
			</staticText>
		</band>
	</title>
</jasperReport>
